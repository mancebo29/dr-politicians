{
  "name": "dr-politicians",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:seed:samples": "tsx --env-file-if-exists=.env.local scripts/seed-sample-profiles.ts",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "tsx --env-file-if-exists=.env.local scripts/admin-promote.ts",
    "research:claim": "tsx --env-file-if-exists=.env.local scripts/research.ts claim",
    "research:validate": "tsx --env-file-if-exists=.env.local scripts/research.ts validate",
    "research:submit": "tsx --env-file-if-exists=.env.local scripts/research.ts submit",
    "research:heartbeat": "tsx --env-file-if-exists=.env.local scripts/research.ts heartbeat",
    "research:token": "tsx --env-file-if-exists=.env.local scripts/research-token.ts",
    "spike:ranking": "tsx scripts/spike-ranking-sources.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12"
  }
}
