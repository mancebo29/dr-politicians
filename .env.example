# Copy to .env.local and fill in. Never commit real values.

# Local Docker Postgres (pnpm db:up). DB_PORT must match the port below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/dr_politicians
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/dr_politicians_test
E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/dr_politicians_e2e
DB_PORT=54329

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional in development; required in production).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional in development; required in production). Without it, emails
# are printed to the server log, or written as JSON to MAIL_OUTBOX_DIR if set.
RESEND_API_KEY=
EMAIL_FROM="Políticos RD <no-reply@example.com>"
# MAIL_OUTBOX_DIR=.tmp/mail

# Research CLI (pnpm research:*). Create a token in /admin/investigacion/tokens
# or with `pnpm research:token <name>` against a local database.
RESEARCH_API_URL=http://localhost:3000
RESEARCH_TOKEN=

# Vercel Cron (/api/cron/*): sent as "Authorization: Bearer <CRON_SECRET>".
# Optional in development (the cron endpoints then refuse every request);
# required in production. Generate with: openssl rand -base64 32
CRON_SECRET=

# Cloudflare Turnstile (sign-up, password reset, anonymous feedback). Optional
# in development (the check is skipped); production refuses those requests
# without it. Cloudflare's test keys always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
